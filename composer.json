{
  "name": "cruding/crud",
  "description": "Universal CRUD route processor bundle for Symfony host applications.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "doctrine/doctrine-bundle": "^3.2",
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/validator": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\Cruding\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": "App\\Cruding\\CrudingBundle"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^12.0"
  },
  "scripts": {
    "canon:cruding": [
      "php tools/cruding/interfacing-provider-rendering-guard.php"
    ]
  }
}
