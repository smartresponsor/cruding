{
  "name": "cruding/crud",
  "description": "Universal CRUD, relation, and object meta surface bundle for Symfony host applications.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "symfony/framework-bundle": "^8.0",
    "symfony/twig-bundle": "^8.0",
    "symfony/security-bundle": "^8.0",
    "doctrine/doctrine-bundle": "^3.2",
    "symfony/http-kernel": "^8.0",
    "symfony/http-foundation": "^8.0",
    "symfony/routing": "^8.0",
    "symfony/validator": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Cruding\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Cruding\\Tests\\": "tests/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": "App\\Cruding\\CrudingBundle"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}
