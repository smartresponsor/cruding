{% extends 'base.html.twig' %}

{% block body %}
    <h1>{{ relation.relationKind|capitalize }} list for {{ crud.resourcePath }}</h1>
    <p>Identifier: {{ crud.identifierField }} = {{ crud.identifierValue }}</p>

    <ul>
        {% for item in relations %}
            <li>
                {{ item }}
            </li>
        {% else %}
            <li>No related items.</li>
        {% endfor %}
    </ul>
{% endblock %}
