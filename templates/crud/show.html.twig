{% extends '@Cruding/base.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block body %}
  <style>
    :root {
      --crud-bg: #f3f6fb;
      --crud-panel: #ffffff;
      --crud-border: #d7deea;
      --crud-text: #1f2937;
      --crud-muted: #5b6574;
      --crud-primary: #2563eb;
      --crud-primary-soft: #dbeafe;
      --crud-accent: #0f172a;
      --crud-radius: 16px;
      --crud-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    }
    body {
      background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 26%),
        radial-gradient(circle at top right, rgba(14, 165, 233, 0.08), transparent 24%),
        var(--crud-bg);
    }
    .crud-shell {
      max-width: 1440px;
      margin: 0 auto;
      padding: 24px;
      color: var(--crud-text);
    }
    .crud-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      padding: 22px 24px;
      border: 1px solid var(--crud-border);
      border-radius: var(--crud-radius);
      background: var(--crud-panel);
      box-shadow: var(--crud-shadow);
    }
    .crud-eyebrow {
      color: var(--crud-primary);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .crud-title {
      margin: 8px 0 0;
      font-size: 30px;
      line-height: 1.12;
    }
    .crud-subtitle {
      margin: 10px 0 0;
      color: var(--crud-muted);
      font-size: 14px;
      max-width: 760px;
    }
    .crud-chips {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 14px;
    }
    .crud-chip {
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid var(--crud-border);
      background: #fafcff;
      color: var(--crud-muted);
      font-size: 12px;
      font-weight: 600;
    }
    .crud-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: flex-end;
      min-width: 240px;
    }
    .crud-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1px solid var(--crud-border);
      background: #fff;
      color: var(--crud-text);
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
    }
    .crud-button-primary {
      background: var(--crud-primary);
      border-color: var(--crud-primary);
      color: #fff;
    }
    .crud-grid {
      margin-top: 16px;
      display: grid;
      grid-template-columns: minmax(280px, .9fr) minmax(0, 1.8fr);
      gap: 16px;
    }
    .crud-card {
      border: 1px solid var(--crud-border);
      border-radius: var(--crud-radius);
      background: var(--crud-panel);
      box-shadow: var(--crud-shadow);
    }
    .crud-card-head {
      padding: 18px 20px 0;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
    }
    .crud-card-title {
      margin: 0;
      font-size: 18px;
      font-weight: 800;
    }
    .crud-card-hint {
      color: var(--crud-muted);
      font-size: 12px;
    }
    .crud-nav {
      padding: 16px 20px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .crud-nav-item {
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid var(--crud-border);
      background: #fcfdff;
    }
    .crud-nav-item strong {
      display: block;
      margin-bottom: 4px;
      font-size: 13px;
    }
    .crud-nav-item span {
      display: block;
      color: var(--crud-muted);
      font-size: 12px;
      line-height: 1.45;
    }
    .crud-details {
      padding: 0 20px 20px;
      display: grid;
      gap: 14px;
    }
    .crud-detail-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .crud-detail {
      padding: 14px;
      border-radius: 12px;
      border: 1px solid #e8edf5;
      background: #fcfdff;
    }
    .crud-detail-label {
      color: var(--crud-muted);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .crud-detail-value {
      margin-top: 6px;
      font-size: 14px;
      font-weight: 600;
      word-break: break-word;
    }
    .crud-object {
      padding: 16px 18px;
      border-radius: 14px;
      border: 1px solid #dbe3ee;
      background: linear-gradient(180deg, #ffffff, #f8fbff);
    }
    .crud-object pre {
      margin: 0;
      white-space: pre-wrap;
      word-break: break-word;
      font-size: 13px;
      line-height: 1.55;
    }
    .crud-footer {
      margin-top: 16px;
      padding: 16px 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: space-between;
      align-items: center;
      border: 1px solid var(--crud-border);
      border-radius: var(--crud-radius);
      background: rgba(255,255,255,.92);
      box-shadow: var(--crud-shadow);
      color: var(--crud-muted);
      font-size: 13px;
    }
    @media (max-width: 1080px) {
      .crud-header, .crud-grid, .crud-footer {
        grid-template-columns: 1fr;
        flex-direction: column;
      }
      .crud-actions { justify-content: flex-start; min-width: 0; }
    }
    @media (max-width: 860px) {
      .crud-shell { padding: 16px; }
      .crud-detail-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="crud-shell">
    <header class="crud-header">
      <div>
        <div class="crud-eyebrow">Generic CRUD shell</div>
        <h1 class="crud-title">{{ page.title }}</h1>
        <p class="crud-subtitle">
          {{ crud.resourcePath }} · {{ crud.identifierField }}={{ crud.identifierValue ?? 'n/a' }} · {{ crud_access.supportsId ? 'ID-backed' : 'slug-backed' }} · {{ crud_access.ownership.canMutate() ? 'mutations allowed' : 'view-only' }}
        </p>
        <div class="crud-chips">
          <span class="crud-chip">surface: {{ crud.surface }}</span>
          <span class="crud-chip">operation: {{ crud.operation }}</span>
          <span class="crud-chip">entity: {{ crud.entityClass|split('\\')|last }}</span>
          <span class="crud-chip">template: {{ crud.template('show') }}</span>
        </div>
      </div>
      <div class="crud-actions">
        {% for action in page.actions %}
          <a class="crud-button{% if action.name == 'edit' %} crud-button-primary{% endif %}" href="{{ path(action.routeName, action.routeParameters) }}">{{ action.label }}</a>
        {% endfor %}
      </div>
    </header>

    <section class="crud-grid">
      <aside class="crud-card">
        <div class="crud-card-head">
          <h2 class="crud-card-title">Navigation</h2>
          <div class="crud-card-hint">current object</div>
        </div>
        <div class="crud-nav">
          <div class="crud-nav-item">
            <strong>Resource</strong>
            <span>{{ crud.resourcePath }}</span>
          </div>
          <div class="crud-nav-item">
            <strong>Identifier</strong>
            <span>{{ crud.identifierField }}={{ crud.identifierValue ?? 'n/a' }}</span>
          </div>
          <div class="crud-nav-item">
            <strong>Access</strong>
            <span>view: {{ crud_access.canView ? 'yes' : 'no' }}, edit: {{ crud_access.canEdit ? 'yes' : 'no' }}, delete: {{ crud_access.canDelete ? 'yes' : 'no' }}</span>
          </div>
          <div class="crud-nav-item">
            <strong>Ownership</strong>
            <span>owner field: {{ crud_access.ownership.ownerField ?? 'n/a' }}, admin: {{ crud_access.ownership.isAdmin ? 'yes' : 'no' }}</span>
          </div>
        </div>
      </aside>

      <main class="crud-card">
        <div class="crud-card-head">
          <h2 class="crud-card-title">Object details</h2>
          <div class="crud-card-hint">loaded from owning-side repository</div>
        </div>
        <div class="crud-details">
          <div class="crud-detail-grid">
            <div class="crud-detail">
              <div class="crud-detail-label">Object class</div>
              <div class="crud-detail-value">{{ object is not null ? 'loaded' : 'n/a' }}</div>
            </div>
            <div class="crud-detail">
              <div class="crud-detail-label">Object id</div>
              <div class="crud-detail-value">{{ object is not null ? object.id|default('n/a') : 'n/a' }}</div>
            </div>
          </div>
        </div>
      </main>
    </section>

    <footer class="crud-footer">
      <div>CRUD shell rendered by <strong>Cruding</strong>, not Accessing.</div>
      <div>resource: {{ crud.resourcePath }} · identifier: {{ crud.identifierField }} · template: {{ page.template }}</div>
    </footer>
  </div>
{% endblock %}
