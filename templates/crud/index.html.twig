{% extends '@Cruding/base.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block body %}
  <style>
    :root {
      --crud-bg: #f3f6fb;
      --crud-panel: #ffffff;
      --crud-border: #d7deea;
      --crud-text: #1f2937;
      --crud-muted: #5b6574;
      --crud-primary: #2563eb;
      --crud-primary-soft: #dbeafe;
      --crud-radius: 16px;
      --crud-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    }
    body {
      background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 26%),
        radial-gradient(circle at top right, rgba(14, 165, 233, 0.08), transparent 24%),
        var(--crud-bg);
    }
    .crud-shell { max-width: 1440px; margin: 0 auto; padding: 24px; color: var(--crud-text); }
    .crud-header, .crud-card, .crud-footer {
      border: 1px solid var(--crud-border);
      border-radius: var(--crud-radius);
      background: var(--crud-panel);
      box-shadow: var(--crud-shadow);
    }
    .crud-header {
      display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 22px 24px;
    }
    .crud-eyebrow { color: var(--crud-primary); font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .crud-title { margin: 8px 0 0; font-size: 30px; line-height: 1.12; }
    .crud-subtitle { margin: 10px 0 0; color: var(--crud-muted); font-size: 14px; max-width: 760px; }
    .crud-actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; min-width: 240px; }
    .crud-button {
      display: inline-flex; align-items: center; justify-content: center; padding: 10px 14px; border-radius: 10px;
      border: 1px solid var(--crud-border); background: #fff; color: var(--crud-text); text-decoration: none; font-size: 14px; font-weight: 700;
    }
    .crud-button-primary { background: var(--crud-primary); border-color: var(--crud-primary); color: #fff; }
    .crud-grid { margin-top: 16px; display: grid; grid-template-columns: minmax(280px, .9fr) minmax(0, 1.8fr); gap: 16px; }
    .crud-card-head { padding: 18px 20px 0; display: flex; justify-content: space-between; gap: 12px; align-items: center; }
    .crud-card-title { margin: 0; font-size: 18px; font-weight: 800; }
    .crud-card-hint { color: var(--crud-muted); font-size: 12px; }
    .crud-nav, .crud-list { padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 12px; }
    .crud-nav-item, .crud-list-item {
      padding: 12px 14px; border-radius: 12px; border: 1px solid var(--crud-border); background: #fcfdff;
    }
    .crud-nav-item strong, .crud-list-item strong { display: block; margin-bottom: 4px; font-size: 13px; }
    .crud-nav-item span, .crud-list-item span { display: block; color: var(--crud-muted); font-size: 12px; line-height: 1.45; }
    .crud-footer {
      margin-top: 16px; padding: 16px 20px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center;
      color: var(--crud-muted); font-size: 13px;
    }
    @media (max-width: 1080px) { .crud-header, .crud-grid, .crud-footer { grid-template-columns: 1fr; flex-direction: column; } .crud-actions { justify-content: flex-start; min-width: 0; } }
    @media (max-width: 860px) { .crud-shell { padding: 16px; } }
  </style>

  <div class="crud-shell">
    <header class="crud-header">
      <div>
        <div class="crud-eyebrow">Commerce resource workspace</div>
        <h1 class="crud-title">{{ page.title }}</h1>
        <p class="crud-subtitle">{{ crud.resourcePath }} · surface {{ crud.surface }} · operation {{ crud.operation }} · {{ page.objects|length }} objects</p>
      </div>
      <div class="crud-actions">
        {% for action in page.actions %}
          <a class="crud-button{% if action.name == 'new' %} crud-button-primary{% endif %}" href="{{ path(action.routeName, action.routeParameters) }}">{{ action.label }}</a>
        {% endfor %}
      </div>
    </header>

    <section class="crud-grid">
      <aside class="crud-card">
        <div class="crud-card-head">
          <h2 class="crud-card-title">Resource snapshot</h2>
          <div class="crud-card-hint">commerce resource</div>
        </div>
        <div class="crud-nav">
          <div class="crud-nav-item"><strong>Resource</strong><span>{{ crud.resourcePath }}</span></div>
          <div class="crud-nav-item"><strong>Surface</strong><span>{{ crud.surface }}</span></div>
          <div class="crud-nav-item"><strong>Mode</strong><span>{{ crud.operation }}</span></div>
          <div class="crud-nav-item"><strong>Template</strong><span>{{ page.template }}</span></div>
        </div>
      </aside>

      <main class="crud-card">
        <div class="crud-card-head">
          <h2 class="crud-card-title">Commerce records</h2>
          <div class="crud-card-hint">{{ page.objects|length }} loaded</div>
        </div>
        <div class="crud-list">
          {% for object in page.objects %}
            <div class="crud-list-item">
              <strong>{{ object.id|default('object') }}</strong>
              <span>{{ object is not null ? 'loaded object' : 'missing object' }}</span>
            </div>
          {% else %}
            <div class="crud-list-item">
              <strong>No commerce records found</strong>
              <span>This resource has no rows yet. Use the resource actions to add or connect commerce data.</span>
            </div>
          {% endfor %}
        </div>
      </main>
    </section>

    <footer class="crud-footer">
      <div>Commerce index rendered by <strong>Cruding</strong>.</div>
      <div>resource: {{ crud.resourcePath }} · template: {{ page.template }}</div>
    </footer>
  </div>
{% endblock %}
