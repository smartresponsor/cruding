{# Minimal fallback surface for Cruding when an Interfacing resource template is not available. #}
{% set title = adminProviderPageTitle|default(workbench.title|default('Cruding')) %}
{% set rows = workbench.rows|default([]) %}
{% set columns = workbench.columns|default([]) %}

<section data-component="cruding" data-view="{{ view|default('index') }}">
    <header>
        <h1>{{ title }}</h1>
        <p>{{ adminProviderResourceLabel|default('Resource') }}</p>
    </header>

    {% if rows is empty %}
        <p>No records available.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    {% for column in columns %}
                        <th>{{ column.label|default(column.key|default('Column')) }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        {% for column in columns %}
                            {% set key = column.key|default('') %}
                            <td>{{ attribute(row, key)|default('') }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>
